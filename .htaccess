<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^login/?$ auth/login/login.php [L,QSA]
    RewriteRule ^register/?$ auth/registration/registration.php [L,QSA]
    RewriteRule ^registration/?$ auth/registration/registration.php [L,QSA]
    RewriteRule ^forgot/?$ auth/forgot/forgot.php [L,QSA]
    RewriteRule ^confirm/?$ auth/otp/otp.php [L,QSA]
    RewriteRule ^resetpassword/?$ auth/reset/reset.php [L,QSA]
    RewriteRule ^otp/?$ auth/otp/otp.php [L,QSA]
    RewriteRule ^reset/?$ auth/reset/reset.php [L,QSA]
    RewriteRule ^403/?$ 403.php [L,QSA]
    RewriteRule ^logout/?$ auth/logout.php [L,QSA]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>
